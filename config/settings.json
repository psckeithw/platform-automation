{
  "Http": {
    "UserAgent": "platform-automation/1.0",
    "TimeoutSec": 60,
    "Retries": 3
  },
  "Collector": {
    "MaxPages": 3
  },
  "Output": {
    "CaptureRawHtml": true,
    "MaxRawItems": 10
  },
  "Run": {
    "BaselineOnColdStart": true
  },
  "Notify": {
    "Enabled": true,
    "WorkItemType": "User Story",
    "CreateForStatuses": ["NEW", "CHANGED"],
    "TopNTestMode": 1,
    "AdditionalTags": []
  }
}
