# Generated artifacts.
# output/ contents are gitignored except for the tracked .gitkeep
# placeholder. state/vendor-state.json is also a generated artifact
# on the dev branch; the pipeline commits it to the dedicated
# `vendor-state` branch (plan §J / §Q1).
output/*
!output/.gitkeep
state/vendor-state.json

